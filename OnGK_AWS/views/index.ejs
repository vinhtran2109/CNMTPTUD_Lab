<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danh sách sản phẩm</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; }
    .container { min-height: 100vh; display: grid; place-items: center; padding: 12px; }
    .list-box { width: 100%; max-width: 900px; border: 1px solid #ccc; padding: 14px; }
    .toolbar { margin: 8px 0; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 650px; }
    th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
    .product-image { width: 64px; height: auto; }
    .actions { display: flex; gap: 6px; }
    .btn { text-decoration: none; }
    .empty { margin: 8px 0 0; }
  </style>
</head>
<body>
  <main class="container">
    <section class="list-box">
      <h1>Danh sách sản phẩm</h1>
      <p class="toolbar"><a class="btn" href="/add">Thêm sản phẩm</a></p>

      <% if (products && products.length > 0) { %>
        <div class="table-wrap">
          <table>
          <thead>
            <tr>
              <th>Ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Giá</th>
              <th>Tồn kho</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr>
                <td>
                  <img src="<%= product.url_image %>" alt="<%= product.name %>" class="product-image" onerror="this.style.display='none'">
                </td>
                <td><%= product.name %></td>
                <td><%= parseFloat(product.price).toFixed(2) %></td>
                <td><%= product.unit_in_stock %></td>
                <td class="actions">
                  <a class="btn" href="/product/<%= product.id %>">Xem</a>
                  <a class="btn" href="/edit/<%= product.id %>">Sửa</a>
                  <button class="btn" onclick="deleteProduct('<%= product.id %>', '<%= product.name %>')">Xóa</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      <% } else { %>
        <p class="empty">Không có sản phẩm.</p>
      <% } %>
    </section>
  </main>
</body>
</html>

<script>
  function deleteProduct(id, name) {
    if (confirm(`Bạn có chắc chắn muốn xóa "${name}"?`)) {
      fetch(`/delete/${id}`, {
        method: 'DELETE'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert('Xóa sản phẩm thành công!');
          window.location.reload();
        } else {
          alert('Lỗi: ' + data.error);
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Đã xảy ra lỗi khi xóa sản phẩm.');
      });
    }
  }
</script>
